{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "scripts/capture-arena.mjs",
    "scripts/subset-jp-font.mjs",
    "scripts/training-fixtures.ts",
    "docs/data/catalogue.ts"
  ],
  "ignorePatterns": [
    "docs/arena/candidates/**"
  ],
  "rules": {
    "private-type-leaks": "warn"
  },
  "typeAware": {
    "enabled": true
  }
}
