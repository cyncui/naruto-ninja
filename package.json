{
  "name": "naruto-ninja",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:catalogue": "node scripts/validate-catalogue.mjs",
    "report:catalogue": "node scripts/validate-catalogue.mjs --write-report",
    "typecheck:catalogue": "tsc -p docs/data/tsconfig.json",
    "check": "npm run validate:catalogue && npm run typecheck && npm run test:unit",
    "dev": "vite",
    "build": "npm run check && vite build && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write src tests",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "predev": "npm run prepare:vision",
    "prebuild": "npm run prepare:vision"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fallow": "3.35.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
